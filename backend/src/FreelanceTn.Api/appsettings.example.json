{
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "freelancetn"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "FreelanceTn",
    "Audience": "FreelanceTnFrontend",
    "ExpiryMinutes": 60,
    "CookieName": "freelancetn_auth"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8443"
    ]
  },
  "Auth": {
    "FrontendUrl": "http://localhost:8443",
    "FrontendBaseUrl": "REPLACE_WITH_PUBLIC_FRONTEND_URL",
    "AppBaseUrl": "REPLACE_WITH_PUBLIC_BACKEND_URL",
    "VerificationTokenHours": 24,
    "ResetTokenMinutes": 60,
    "ResendCooldownSeconds": 60,
    "ForgotPasswordCooldownSeconds": 60,
    "RememberMeDays": 30,
    "TeamInviteTokenHours": 168,
    "MaxImageUploadMb": 5,
    "ExposeDevEmailLinks": false,
    "Google": {
      "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
      "ClientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET",
      "RedirectUri": "http://localhost:8443/api/auth/google/callback"
    },
    "Email": {
      "Host": "smtp.example.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "REPLACE_WITH_SMTP_USERNAME",
      "Password": "REPLACE_WITH_SMTP_PASSWORD",
      "FromAddress": "no-reply@example.com",
      "FromName": "FreelanceTN",
      "DevOutboxPath": "App_Data/dev-emails"
    }
  },
  "Konnect": {
    "Enabled": false,
    "BaseUrl": "https://api.sandbox.konnect.network/api/v2/",
    "ApiKey": "REPLACE_WITH_SANDBOX_API_KEY",
    "ReceiverWalletId": "REPLACE_WITH_SANDBOX_RECEIVER_WALLET_ID",
    "TimeoutSeconds": 20,
    "LifespanMinutes": 15,
    "Theme": "light"
  }
}

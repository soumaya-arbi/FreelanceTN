{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "",
    "DatabaseName": "freelancetn",
    "UsersCollection": "users",
    "FreelancerProfilesCollection": "freelancerProfiles",
    "ServicesCollection": "services",
    "ProjectsCollection": "projects",
    "ProposalsCollection": "proposals",
    "TasksCollection": "tasks",
    "QuotesCollection": "quotes",
    "InvoicesCollection": "invoices",
    "FeedbackCollection": "feedback",
    "PortfolioCollection": "portfolio",
    "CountersCollection": "counters"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "FreelanceTn",
    "Audience": "FreelanceTnFrontend",
    "ExpiryMinutes": 60,
    "CookieName": "freelancetn_auth"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8443"
    ]
  },
  "Auth": {
    "FrontendUrl": "http://localhost:8443",
    "FrontendBaseUrl": "",
    "AppBaseUrl": "",
    "VerificationTokenHours": 24,
    "ResetTokenMinutes": 60,
    "ResendCooldownSeconds": 60,
    "ForgotPasswordCooldownSeconds": 60,
    "RememberMeDays": 30,
    "TeamInviteTokenHours": 168,
    "MaxImageUploadMb": 5,
    "ExposeDevEmailLinks": false,
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:8443/api/auth/google/callback"
    },
    "Email": {
      "Mode": "auto",
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "",
      "FromAddress": "no-reply@freelancetn.local",
      "FromName": "FreelanceTN",
      "DevOutboxPath": "App_Data/dev-emails",
      "TimeoutSeconds": 15
    }
  },
  "Konnect": {
    "Enabled": false,
    "BaseUrl": "https://api.sandbox.konnect.network/api/v2/",
    "ApiKey": "",
    "ReceiverWalletId": "",
    "TimeoutSeconds": 20,
    "LifespanMinutes": 15,
    "Theme": "light"
  },
  "Feedback": {
    "IntervalSeconds": 300,
    "StartupDelaySeconds": 15
  }
}

# FreelanceTN API — variables d'environnement (exemple)
# Copiez ce fichier en .env (non versionné) et adaptez les valeurs.
# Ces variables surchargent appsettings.json via la configuration ASP.NET Core
# (préfixe standard : Mongo__ / Jwt__ / Cors__).

# --- MongoDB ---
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__DatabaseName=freelancetn

# --- JWT (secret long et aléatoire, >= 32 caractères) ---
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=FreelanceTn
Jwt__Audience=FreelanceTnFrontend
Jwt__ExpiryMinutes=60
Jwt__CookieName=freelancetn_auth

# --- CORS (origine réelle du frontend) ---
Cors__AllowedOrigins__0=http://localhost:8443

# --- E-mail transactionnel ---
# auto (défaut) | smtp | dev-outbox | none
# auto : SMTP si Auth__Email__Host est renseigné, sinon dev-outbox en Development.
# dev-outbox : écrit les messages dans App_Data/dev-emails (développement uniquement).
Auth__Email__Mode=auto
Auth__Email__Host=
Auth__Email__Port=587
Auth__Email__UseStartTls=true
Auth__Email__Username=
# Ne jamais committer de mot de passe : préférer les .NET User Secrets
# (dotnet user-secrets set "Auth:Email:Password" "...").
Auth__Email__Password=
Auth__Email__FromAddress=no-reply@freelancetn.local
Auth__Email__FromName=FreelanceTN
Auth__Email__DevOutboxPath=App_Data/dev-emails
Auth__Email__TimeoutSeconds=15
